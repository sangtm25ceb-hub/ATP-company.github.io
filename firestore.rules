rules_version = '2';
service cloud.firestore { match /databases/{db}/documents {
  function U(id){ return get(/databases/$(db)/documents/users/$(id)).data; }
  function ok(){ return request.auth != null && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && U(request.auth.uid).approved == true; }
  function staff(id){ return U(id).role in ['staff','admin']; }
  function admin(){ return ok() && U(request.auth.uid).role == 'admin'; }
  match /users/{id} {
    allow read: if request.auth != null && (request.auth.uid == id || (ok() && (staff(request.auth.uid) || resource.data.role in ['staff','admin'])));
    allow create: if request.auth.uid == id && request.resource.data.role == 'customer' && request.resource.data.approved == false && request.resource.data.keys().hasOnly(['name','role','approved']);
    allow update: if admin();
  }
  match /projects/{id} { allow read: if ok(); allow write: if admin(); }
  match /rooms/{room}/messages/{m} {
    // phòng riêng có id = uid1_uid2 (đã sắp xếp)
    function inRoom(){ return room == 'general' || request.auth.uid in room.split('_'); }
    allow read: if ok() && inRoom();
    allow create: if ok() && inRoom() && request.resource.data.from == request.auth.uid
      && (request.resource.data.type == 'text' || admin())
      && (room == 'general' || staff(room.split('_')[0]) || staff(room.split('_')[1]));
allow delete: if ok()
  && resource.data.from == request.auth.uid;
  }
}}
